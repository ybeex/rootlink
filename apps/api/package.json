{
  "name": "@rootlink/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env --tsconfig tsconfig.json src/server.ts",
    "dev:worker": "tsx watch --tsconfig tsconfig.json src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@rootlink/shared": "*",
    "@rootlink/db": "*",
    "fastify": "^5.2.1",
    "@fastify/cors": "^10.0.2",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/jwt": "^9.0.2",
    "@fastify/sensible": "^6.0.3",
    "@fastify/request-context": "^6.0.1",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.1",
    "zod": "^3.24.1",
    "argon2": "^0.43.0",
    "jsonwebtoken": "^9.0.2",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "bullmq": "^5.34.8",
    "ioredis": "^5.4.2",
    "sharp": "^0.33.5",
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "nodemailer": "^6.10.1",
    "@anthropic-ai/sdk": "^0.39.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "nanoid": "^5.0.9",
    "ms": "^2.1.3",
    "p-retry": "^6.2.1",
    "file-type": "^19.6.0",
    "@bull-board/api": "^8.3.0",
    "@bull-board/fastify": "^8.3.0",
    "stripe": "^17.4.0",
    "node-cron": "^3.0.3",
    "@fastify/websocket": "^11.0.2"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "tsx": "^4.19.2",
    "vitest": "^3.0.5",
    "@vitest/coverage-v8": "^3.0.5",
    "@types/node": "^22.13.1",
    "@types/ms": "^0.7.34",
    "@types/qrcode": "^1.5.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/ws": "^8.5.14"
  }
}
