# ── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://rootlink:rootlink_dev@localhost:5432/rootlink
DB_MAX_CONNECTIONS=20

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_with_64_char_hex_string_access_secret_here_xxxxxxxx
JWT_REFRESH_SECRET=replace_me_with_64_char_hex_string_refresh_secret_here_xxxxxxxx
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Storage (MinIO local dev) ────────────────────────────────────────────────
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=rootlink-media
STORAGE_ACCESS_KEY_ID=rootlink
STORAGE_SECRET_ACCESS_KEY=rootlink_dev_secret
STORAGE_PUBLIC_URL=http://localhost:9000/rootlink-media

# ── Email ───────────────────────────────────────────────────────────────────
# Leave blank in dev to skip email sending (logs to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@rootlink.app

# ── App URLs ────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000

# Refresh-token cookie domain. Leave unset for local dev (cookie scoped to
# localhost). In production with api.rootlink.app + rootlink.app, set to
# .rootlink.app so both subdomains receive the refresh-token cookie.
# COOKIE_DOMAIN=.rootlink.app

# ── Features ────────────────────────────────────────────────────────────────
ENABLE_AI_FEATURES=false
ANTHROPIC_API_KEY=

# ── Billing (Stripe) ─────────────────────────────────────────────────────────
# Leave all four unset to run without billing — the rest of the app works
# fine; only checkout/portal/webhook calls will return a clear 503 instead
# of silently pretending to work. Get these from the Stripe dashboard:
# secret key under Developers > API keys, webhook secret under Developers >
# Webhooks (after creating an endpoint pointing at <API_URL>/v1/billing/webhook),
# and the two price IDs from Products > [plan] > Pricing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PLUS=
STRIPE_PRICE_ID_PRO=

# ── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL=debug
SENTRY_DSN=

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_TRUST_PROXY=false
