{
  "compilerOptions": {
    "target":              "ES2022",
    "module":              "NodeNext",
    "moduleResolution":    "NodeNext",
    "lib":                 ["ES2022"],
    "strict":              true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop":     true,
    "skipLibCheck":        true,
    "baseUrl":             ".",
    "paths": {
      "@helpers/*": ["./helpers/*"],
      "@pages/*":   ["./page-objects/*"]
    }
  },
  "include": ["**/*.ts"]
}
